---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, profile } from "../../data/resume";

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---

<BaseLayout title={`${project.title} | 원승혁`} description={project.summary}>
  <header class="site-header shell">
    <a class="wordmark" href="/" aria-label="원승혁 포트폴리오 홈">W.</a>
    <nav aria-label="주요 메뉴"><a href="/#projects">전체 프로젝트</a><a href="/resume.md" download="원승혁_간단이력서.md">이력서 ↓</a></nav>
  </header>
  <main id="main-content" class="case-study shell">
    <header class="case-header">
      <p class="eyebrow">{project.type}</p>
      <h1>{project.title}</h1>
      {project.subtitle && <p class="case-subtitle">{project.subtitle}</p>}
      <p class="case-intro">{project.summary}</p>
      <dl class="case-facts"><div><dt>기간</dt><dd>{project.period}</dd></div><div><dt>담당 역할</dt><dd>{project.role}</dd></div></dl>
      <div class="tag-list">{project.tags.map(tag => <span>{tag}</span>)}</div>
    </header>
    <section class="case-context"><h2>프로젝트 배경</h2><p>{project.context}</p></section>
    <div class="case-sections">
      {project.sections.map((section, i) => <section class="case-section">
        <div><p class="section-index">{String(i + 1).padStart(2, "0")}</p><h2>{section.title}</h2>{section.status && <p class="scope-label">{section.status}</p>}</div>
        <div>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
      </section>)}
    </div>
    <section class="case-outcome"><h2>결과</h2><p>{project.outcome}</p></section>
    <div class="case-links"><a class="button button-primary" href="/#projects">다른 프로젝트 보기</a>{project.href && <a class="button button-ghost" href={project.href} target="_blank" rel="noreferrer">GitHub ↗</a>}<a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 ↗</a></div>
  </main>
  <footer class="site-footer"><div class="shell"><span>원승혁 · {profile.updated} 기준</span><a href="/">포트폴리오 홈 ↑</a></div></footer>
</BaseLayout>
