---
import BaseLayout from "../layouts/BaseLayout.astro";

import { profile, projects, skills, career } from "../data/resume";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "원승혁",
  url: "https://3759357.github.io",
  jobTitle: "Backend & Platform Engineer",
  sameAs: ["https://github.com/3759357", "https://velog.io/@3759357/posts", "https://seung-hyeok-won.notion.site/97cefba54b304f59b97bb29018662d63"],
};
---

<BaseLayout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header class="site-header shell">
    <a class="wordmark" href="#top" aria-label="첫 화면으로 이동">W.</a>
    <nav aria-label="주요 메뉴"><a href="#work">경력</a><a href="#projects">프로젝트</a><a href="#skills">기술</a><a href="#contact">연락</a></nav>
  </header>

  <main id="main-content"><span id="top"></span>
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Backend & Platform Engineer</p>
        <h1 id="hero-title">백엔드 개발자<br /><em>원승혁입니다.</em></h1>
        <p class="hero-description">{profile.summary}</p>
        <div class="hero-actions"><a class="button button-primary" href="#projects">프로젝트 보기</a><a class="button button-ghost" href="/resume.md" download="원승혁_간단이력서.md">이력서 다운로드 <span aria-hidden="true">↓</span></a></div>
      </div>
      <aside class="hero-aside" aria-label="핵심 역량">
        <div class="status-row"><span class="status-dot"></span><span>Seoul · Open to opportunities</span></div>
        <p class="aside-label">CURRENTLY</p><p class="aside-title">고려대학교<br />소프트웨어보안연구소</p>
        <p class="aside-stack">Java · Spring Boot<br />Kafka 파이프라인 운영·유지보수</p>
      </aside>
    </section>

    <section class="impact shell" aria-label="핵심 성과">
      <article><strong><small>약 </small>10<span>종</span></strong><p>이질적 연구 도구<br />단일 서비스 통합</p></article>
      <article><strong><small>약 </small>1,500<span>만</span></strong><p>C/C++ OSS 해시<br />데이터 분석·검증</p></article>
      <article><strong>85<span>%</span></strong><p>배포 시간 단축<br />10분 → 1분 30초</p></article>
    </section>

    <section class="work-section section shell" id="work" aria-labelledby="work-title">
      <div class="section-heading"><p class="section-index">01 / EXPERIENCE</p><h2 id="work-title">서비스 통합부터<br /><em>운영 개선까지.</em></h2></div>
      <div class="experience-grid">
        <aside class="experience-meta"><p class="meta-period">2026.01 — PRESENT</p><h3>고려대학교 산학협력단</h3><p>소프트웨어보안연구소 · 연구원</p></aside>
        <div class="experience-story">
          <p class="story-lead">IoTcube/HatBOM의 백엔드를 담당하며, 도구별 제약과 서비스 경계를 재설계했습니다.</p>
          <div class="story-list">
            {career.map((item, i) => <article><span>{String(i + 1).padStart(2, "0")}</span><div><h4>{item.title}</h4><p>{item.text}</p></div></article>)}
          </div>
          <a class="text-link" href="/projects/iotcube/">구현·운영 경험과 전환 설계 자세히 보기 →</a>
        </div>
      </div>
    </section>

    <section class="flow-section" aria-label="플랫폼 흐름"><div class="shell flow-inner"><div><span>UPLOAD</span><strong>입력 판별</strong></div><i></i><div><span>ROUTING</span><strong>도구 선택</strong></div><i></i><div><span>EXECUTION</span><strong>격리·실행</strong></div><i></i><div><span>RESULT</span><strong>SBOM · VEX · CVE</strong></div></div></section>

    <section class="projects-section section shell" id="projects" aria-labelledby="projects-title">
      <div class="section-heading heading-row"><div><p class="section-index">02 / SELECTED PROJECTS</p><h2 id="projects-title">주요 프로젝트와<br /><em>직접 맡은 일.</em></h2></div><p>각 프로젝트에서 맡은 역할과<br />구현·검증 내용을 정리했습니다.</p></div>
      <div class="project-grid">
        {projects.map((project) => <article class={`project-card accent-${project.accent}`}>
          <div class="project-topline"><span>{project.index}</span><span>{project.type}</span></div>
          <h3>{project.title}</h3>
          {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
          <p class="project-summary">{project.summary}</p>
          <div class="project-facts"><span>{project.role}</span><span>{project.period}</span></div>
          <ul>{project.highlights.map((item) => <li>{item}</li>)}</ul>
          <div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div>
          <div class="project-actions"><a href={`/projects/${project.slug}/`} aria-label={`${project.title} 상세 보기`}>프로젝트 상세 →</a>{project.href && <a href={project.href} target="_blank" rel="noreferrer">GitHub ↗</a>}</div>
        </article>)}
      </div>
    </section>

    <section class="principles-section"><div class="section shell principles-grid"><div class="section-heading compact"><p class="section-index light">03 / HOW I WORK</p><h2>작은 결정이<br /><em>결과를 바꿉니다.</em></h2></div><ol class="principle-list"><li><span>01</span><div><strong>전체를 보기</strong><p>코드보다 입력과 의존성의 의도를 먼저 파악합니다.</p></div></li><li><span>02</span><div><strong>제약을 경계로 바꾸기</strong><p>데이터·장애·운영 제약을 프로덕트 경계로 만듭니다.</p></div></li><li><span>03</span><div><strong>기록도 시스템의 일부</strong><p>아키텍처와 의사결정을 남겨 다음 사람의 탐색 비용을 낮춥니다.</p></div></li></ol></div></section>

    <section class="skills-section section shell" id="skills" aria-labelledby="skills-title"><div class="section-heading heading-row"><div><p class="section-index">04 / TOOLBOX</p><h2 id="skills-title">실무와 프로젝트에서<br /><em>사용한 기술.</em></h2></div></div><div class="skills-grid">{skills.map((group) => <article><p>{group.label}</p><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div></section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="shell contact-inner"><p class="section-index light">05 / CONTACT</p><h2 id="contact-title">복잡한 문제를<br /><em>함께 풀고 싶습니다.</em></h2><p>백엔드 개발, 플랫폼 엔지니어링, 보안 도메인 지원에 관해 이야기를 나누고 싶습니다.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a><div class="contact-links"><a href="https://github.com/3759357" target="_blank" rel="noreferrer">GitHub <span>↗</span></a><a href="https://velog.io/@3759357/posts" target="_blank" rel="noreferrer">Velog <span>↗</span></a><a href="https://seung-hyeok-won.notion.site/97cefba54b304f59b97bb29018662d63" target="_blank" rel="noreferrer">Notion <span>↗</span></a></div></div></section>
  </main>

  <footer class="site-footer"><div class="shell"><span>© 2026 WON SEUNG HYEOK · UPDATED {profile.updated}</span><a href="#top">BACK TO TOP ↑</a></div></footer>
</BaseLayout>
